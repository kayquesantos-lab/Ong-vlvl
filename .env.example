# ─── Django ──────────────────────────────────────────────────────────────────
SECRET_KEY=troque-isso-em-producao-use-secrets-token-urlsafe-50
DEBUG=False

# Hosts permitidos (separe por virgula)
ALLOWED_HOSTS=localhost,127.0.0.1,seu-backend.onrender.com

# ─── Database ────────────────────────────────────────────────────────────────
# Postgres (producao). Pegue do Neon/Supabase no formato:
#   postgres://USER:PASS@HOST:PORT/DB
# Em dev local com SQLite pode usar:
#   sqlite:///db.sqlite3
DATABASE_URL=postgres://user:pass@host:5432/dbname

# ─── CORS / CSRF ─────────────────────────────────────────────────────────────
# URLs do frontend que podem chamar a API
CORS_ALLOWED_ORIGINS=http://localhost:3000,https://seu-app.vercel.app
CSRF_TRUSTED_ORIGINS=http://localhost:3000,https://seu-app.vercel.app
